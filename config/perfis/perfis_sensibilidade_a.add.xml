<?xml version="1.0" encoding="UTF-8"?>
<additional>
    <!--
      Sensibilidade A:
      - mantém o perfil normal como âncora;
      - aumenta moderadamente o contraste entre cauteloso e agressivo;
      - mantém jmTimegapMinor igual a 0.80 nos três perfis;
      - mantém lcStrategic = 1.0 e o lookahead padrão do SUMO.
      Este arquivo é experimental e NÃO substitui o baseline perfis.add.xml.
    -->

    <vType id="cauteloso"
           vClass="passenger"
           carFollowModel="Krauss"
           tau="1.40"
           minGap="3.50"
           accel="2.30"
           decel="3.80"
           sigma="0.50"
           speedFactor="0.85"
           speedDev="0.10"
           lcAssertive="0.70"
           lcStrategic="1.0"
           impatience="-0.40"
           jmTimegapMinor="0.80"
           color="0,0,1"/>

    <vType id="normal"
           vClass="passenger"
           carFollowModel="Krauss"
           tau="1.00"
           minGap="2.50"
           accel="2.60"
           decel="4.50"
           sigma="0.50"
           speedFactor="1.00"
           speedDev="0.10"
           lcAssertive="1.00"
           lcStrategic="1.0"
           impatience="0.00"
           jmTimegapMinor="0.80"
           color="0,1,0"/>

    <vType id="agressivo"
           vClass="passenger"
           carFollowModel="Krauss"
           tau="0.65"
           minGap="1.70"
           accel="3.10"
           decel="5.20"
           sigma="0.50"
           speedFactor="1.15"
           speedDev="0.10"
           lcAssertive="1.35"
           lcStrategic="1.0"
           impatience="0.40"
           jmTimegapMinor="0.80"
           color="1,0,0"/>
</additional>
